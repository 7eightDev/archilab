# Studio inbox: receives the requests, and is offered to visitors while the form cannot deliver.
CONTACT_EMAIL=

# Email delivery through Resend (https://resend.com). The form stays disabled until all three are set.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Sito Archilab <sito@archilab.it>".
CONTACT_FROM_EMAIL=
